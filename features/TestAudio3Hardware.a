kHardwareTest_UsingSprites4 = 1
kBus24Bit_Sprites4_Controls2		= $b800
kBus24Bit_Sprites4_Registers2		= $b808

kBus24Bit_VideoLayer_HasOverscan=1
kBus24Bit_VideoLayer_ExpandedPalettes = 1
kBus24Bit_VideoLayer_ExpandedPaletteLayers = 1
;kBus24Bit_VideoLayer_VBlankUseNMI = 1
kBus24Bit_SpritesMaxNum = 32

!sal
!pdb "target/t.pdb"
!source "stdlib/stdlib.a"
!source "stdlib/Comparisons.a"
!source "stdlib/LongBranches.a"
!source "BombJack/stdlib/Bus24Bit_Macros.a"
!source "BombJack/stdlib/Bus20To32Bit1_Macros.a"
!source "BombJack/stdlib/Video_Macros.a"
!source "BombJack/stdlib/APU_Macros.a"
!source "VideoHardware/asm/AfterBurner/Audio2_Macros.a"

kAudio3SampleRate_Full = 0x8000
kAudio3SampleRate_25000Hz = 0x55C2
kAudio3SampleRate_12500Hz = 0x2ae1

*=$200
!zn
	+MStopInitStack_X
start

	lda #ProcessorPortAllRAMWithIO
	jsr InitialiseMachine

	jsr Bus24Bit_Init
	jsr Bus20To32Bit1_Init
	jsr APU_ResetDisableClear
	jsr Video_DisableDisplay
	jsr APU_ResetDisableClear

	jsr Audio_Init

    jsr Audio2_Disable

	jsr Audio3Init

	+WaitForFire_A

	jsr Bus24Bit_Init
;	jsr Bus20To32Bit1_Init

	jsr Bus24Bit_Init
;	jsr Bus20To32Bit1_Init
	jsr APU_ResetDisableClear
	jsr Video_DisableDisplay
	jsr APU_ResetDisableClear

	jsr Bus24Bit_Init
;	jsr Bus20To32Bit1_Init
	jsr HardwareTest_VideoPattern0

	jsr Video_DisableDisplay
	
	jsr Audio3Init

	+MBus24Bit_SetAddress_A kAudio2_EBBS , kAudio2_LeftChannel + kAudio2Register_Bank
	+MBus24Bit_Send8BitValue $10

    jsr DoCopy

.playIt
	jsr Bus24Bit_Init
;	jsr Bus20To32Bit1_Init
	+MBus24Bit_SetAddress_A kAudio2_EBBS , kAudio2_LeftChannel + kAudio2Register_Volume
	+MBus24Bit_Send8BitValue 255
	+MBus24Bit_SetAddress_A kAudio2_EBBS , kAudio2_LeftChannel + kAudio2Register_Control
	+MBus24Bit_Send8BitValue 0
	

;	+MAudio2_SetSample kAudio2_LeftChannel , 0 , TotalSampleEnd - TotalSampleStart , kAudio3SampleRate_12500Hz
;	+MAudio2_SetSample kAudio2_LeftChannel , 0 , $4000 , kAudio3SampleRate_Full
;	+MAudio2_SetSample kAudio2_LeftChannel , 0 , $10000 , kAudio3SampleRate_Full
;	+MAudio2_SetSample kAudio2_LeftChannel , 0 , $10000 , kAudio3SampleRate_Full / 13
;	+MAudio2_SetSample kAudio2_LeftChannel , 0 , $10000 , kAudio3SampleRate_25000Hz
;	+MAudio2_SetSample kAudio2_LeftChannel , 0 , $10000 , kAudio3SampleRate_12500Hz / 10
;	+MAudio2_SetSample kAudio2_LeftChannel , 0 , $10000 , kAudio3SampleRate_12500Hz
;	+MAudio2_SetSample kAudio2_LeftChannel , 0 , $8000 , kAudio3SampleRate_Full / 9	; With 4/5MHz
	+MAudio2_SetSample kAudio2_LeftChannel , $100002 , $8000 , kAudio3SampleRate_Full

	+MBus24Bit_SetAddress_A kAudio2_EBBS , kAudio2_LeftChannel + kAudio2Register_Control
	+MBus24Bit_Send8BitValue kAudio2Register_Control_Enable

;	rts


	+WaitForFire_A
	+MByteValueToAddress_A VIC2Colour_Red , VIC2BorderColour
	+MBus24Bit_SetAddress_A kAudio2_EBBS , kAudio2_LeftChannel + kAudio2Register_Volume
	+MBus24Bit_Send8BitValue 255
	+MBus24Bit_SetAddress_A kAudio2_EBBS , kAudio2_LeftChannel + kAudio2Register_Control
	+MBus24Bit_Send8BitValue 0
	+WaitForFire_A
	+MByteValueToAddress_A VIC2Colour_Blue , VIC2BorderColour
	jmp .playIt


.l1
	+MByteValueToAddress_A VIC2Colour_Red , VIC2BorderColour
	+MByteValueToAddress_A VIC2Colour_Blue , VIC2BorderColour
	jmp .l1


Audio3Init
	jsr Bus24Bit_Init
;	jsr Bus20To32Bit1_Init
	+MBus24Bit_SetAddress_A kAudio2_EBBS , kAudio2_LeftChannel + kAudio2Register_Bank
	lda #0
	ldy #12
	jsr Bus24Bit_WriteAForY
	rts


!source "BombJack/stdlib/Bus24Bit.a"
!source "BombJack/stdlib/Bus20To32Bit1.a"
!source "BombJack/stdlib/APU.a"
!source "BombJack/stdlib/Audio.a"
!source "BombJack/stdlib/Video.a"
!source "BombJack/stdlib/HardwareTest.a"
!source "VideoHardware/asm/AfterBurner/Audio2.a"

TotalSampleStart
SampleStart
!bin "c:\temp\t.vcd" , $8000 , $0
;!for .i , $40 {
;!fill $100 , $01
;!fill $100 , $11
;}
SampleEnd

;SampleStart3
;!bin "c:\work\c64\VideoHardware\assets\Demo14\Audio\aburner_left.vcd" , $3000 , $8000
;SampleEnd3
TotalSampleEnd


Initialise_NoPreserveStack = 1
Initialise_NoIRQServiceRoutine = 1
Initialise_NoMACROWaitForTheLastScan = 1
!source "stdlib/Initialise.a"

DoCopy
!for .ii , $80 {
!set .i = .ii-1
	+MBus24Bit_SetAddress_A $06 , ($100 * .i) + $0002
	+MWordValueTo_AX SampleStart + ($100 * .i)
	ldy #0
	jsr Bus24Bit_FastCopySmallData
;	ldx #$10
;	jsr Bus24Bit_FastCopySmallDataRepeatForX
}

	; Terminate data stream
	+MBus24Bit_Send8BitValue $ff
	+MBus24Bit_Send8BitValueFromA
	+MBus24Bit_Send8BitValueFromA
	+MBus24Bit_Send8BitValueFromA

    rts
